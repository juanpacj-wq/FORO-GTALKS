# ==============================================================================
#  Foro G-TALKS unit de systemd
#
#  Instalación:
#    sudo cp gtalks.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now gtalks
#
#  Entre ediciones el servicio se PARA (`systemctl disable --now gtalks`). Ver docs/SEGURIDAD.md.
# ==============================================================================
[Unit]
Description=Foro GECELCA G-TALKS gate Entra ID
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gtalks
Group=gtalks
WorkingDirectory=/opt/gtalks

# Los secretos NO viven en el directorio de la app: así un `git pull` no puede pisarlos y el
# usuario del servicio no necesita permiso para leerlos.
# Permisos 0600 root:root systemd parsea este archivo como PID 1, antes de bajar privilegios,
# así que el usuario del servicio nunca lo abre. Es más estrecho que el 0640 habitual y funciona.
EnvironmentFile=/etc/gtalks/env
Environment=NODE_ENV=production

ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5s
# El proceso cierra ordenadamente con SIGTERM (ver server/index.js).
KillSignal=SIGTERM
TimeoutStopSec=15s

# --- Endurecimiento --------------------------------------------------------
# Más estricto que el modelo del proyecto hermano: allí hay BD y uploads, aquí NO hay nada que
# escribirel sitio es estático y las sesiones viven en memoria a propósito—, salvo el registro
# de acceso. De ahí que ReadWritePaths tenga una sola ruta.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
# MemoryDenyWriteExecute NO se activa: el JIT de V8 marca páginas ya escritas como
# ejecutables (mprotect W→X), la directiva se lo prohíbe y V8 lo trata como error FATAL,
# no como degradación: el proceso cae con «Check failed: 12 == errno» en
# SetPermissionsOnExecutableMemoryChunk (status=5/TRAP) y systemd lo reinicia en bucle.
# Comprobado en el primer arranque real en producción (2026-07-31). Correr Node con
# --jitless sí sería compatible, pero es un intérprete puro: no es opción seria aquí.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

# Dos rutas escribibles, y son cosas distintas:
#   · /var/log/gtalks  el registro de asistencia (AUDIT_LOG_PATH). ROTA (logrotate, 90 días).
#   · /var/lib/gtalks  el libro de inscripciones (INSCRIPCION_LIBRO). Es ESTADO, no un log:
#     si se rotara, tras el siguiente reinicio el servidor volvería a mandarle el correo de
#     inscripción a todo el mundo. Por eso vive aquí y no allí. StateDirectory lo crea con el
#     dueño correcto (0700 gtalks:gtalks) e implica su ruta escribible.
ReadWritePaths=/var/log/gtalks
StateDirectory=gtalks

# NOTA: aquí vivían `IPAddressAllow=localhost` + `IPAddressDeny=any`. Se quitaron porque ese
# filtro aplica también a la SALIDA, y este proceso tiene que hablar con login.microsoftonline.com
# (el canje del código de autorización) y con graph.microsoft.com (el cargo del asistente y el
# correo de inscripción). Con ellos puestos, el login no puede completarse.
# La restricción de ENTRADA ya la dan `listen('127.0.0.1')` (server/index.js), nginx como único
# interlocutor y ufw en el borde. Si algún día se quiere control de egress de verdad, va en
# nftables contra los rangos de Microsoft 365 y no aquí: esos rangos cambian, y un unit
# desactualizado se convierte en una caída silenciosa a mitad de evento.

[Install]
WantedBy=multi-user.target

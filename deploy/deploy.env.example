# ==============================================================================
#  Coordenadas del servidor de despliegue plantilla
#
#  Copia este archivo a `deploy/deploy.env` y llénalo. Ese archivo está gitignored
#  a propósito: no son secretos, pero sí la topología interna (host, usuario, puerto
#  SSH, rutas). Este repositorio tiene remoto en GitHub y el inventario de máquinas
#  internas no tiene por qué viajar ahí.
#
#  El proyecto hermano (PORTALES GECELCA) los lleva incrustados en su `deploy.sh`
#  porque su repo no sale de la red corporativa. Aquí sí sale.
#
#  Alternativa: exportar estas mismas variables en el entorno antes de correr el
#  script. Lo que esté en el entorno gana sobre el archivo.
# ==============================================================================

# --- Acceso SSH ---------------------------------------------------------------
# Autenticación por LLAVE, nunca por contraseña: el script corre con BatchMode=yes
# y cualquier prompt interactivo lo hace fallar en vez de colgarse esperando.
# La contraseña de la cuenta sigue custodiada en PMP; el despliegue no la usa.
GTALKS_SSH_HOST=usuario@servidor.gecelca.com.co
GTALKS_SSH_PORT=22
GTALKS_SSH_KEY=$HOME/.ssh/id_ed25519

# --- Rutas en el servidor -----------------------------------------------------
# GTALKS_APP_DIR es el WorkingDirectory de la unit (deploy/systemd/gtalks.service).
# Las generaciones prev/ y stage/ viven al lado, en el MISMO sistema de archivos:
# el intercambio es por `mv`, y un `mv` entre sistemas de archivos deja de ser
# instantáneo y deja de ser atómico.
GTALKS_APP_DIR=/opt/gtalks
GTALKS_SERVICIO=gtalks
GTALKS_USUARIO_SERVICIO=gtalks

# --- Comprobación de salud ----------------------------------------------------
# Puerto en el que escucha Express dentro del servidor (SERVER_PORT de /etc/gtalks/env).
GTALKS_PORT=3000
# URL pública. Se usa para comprobar, desde tu máquina, que nginx + TLS + DNS también
# están de pie. Si tu estación no la alcanza, el script lo dice y no lo toma como fallo
# del sitio (ver docs/DESPLIEGUE.md §comprobación de salud).
GTALKS_URL=https://cdp.gecelca.com.co

# --- Despliegue automático al commitear (opt-in) ------------------------------
# Con 1, el hook `post-commit` (si lo instalaste) despliega solo al commitear en main.
# Vacío o 0: el hook solo AVISA que hay algo sin desplegar. Ver docs/DESPLIEGUE.md.
GTALKS_AUTODEPLOY=0

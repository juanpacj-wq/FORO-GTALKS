# Registro de asistencia al foro (AUDIT_LOG_PATH). Contiene el correo corporativo de cada
# asistente: es un dato personal y tiene plazo de borrado, no se guarda indefinidamente.
#
#   sudo cp gtalks /etc/logrotate.d/gtalks
#
# 90 días = 12 rotaciones semanales. Ver docs/SEGURIDAD.md §Registro de acceso para el
# responsable del borrado y el aviso de privacidad que se muestra en la pantalla de login.
/var/log/gtalks/acceso.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    create 0640 gtalks gtalks
    su gtalks gtalks
    # El proceso mantiene el descriptor abierto: copytruncate evita tener que reiniciar el
    # servicio en cada rotación.
    copytruncate
}

# ─── Login Microsoft Entra ID (OIDC Auth Code + PKCE, cliente confidencial) ───
# App Registration (Azure Portal → Entra ID → App registrations). El sitio es público; esto
# gobierna solo la IDENTIDAD de la escarapela: quién puede iniciar sesión lo decide la
# Enterprise App con "Asignación requerida = Sí" + los usuarios/grupos asignados.
# NUNCA pegues credenciales reales en este archivo: es versionado. Sólo placeholders.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Redirect/post-logout. Registrar TODAS las que se usen en el App Registration → Authentication
# (plataforma Web):
#   dev  : http://localhost:5173/auth/redirect   y  http://localhost:5173/
#   prod : https://<dominio-del-evento>/auth/redirect  y  https://<dominio-del-evento>/
M365_REDIRECT_URI=http://localhost:5173/auth/redirect
M365_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# Scopes. `offline_access` habilita el refresh token de la revalidación silenciosa, y `User.Read`
# permite leer el CARGO de quien entra: no es un claim de OIDC, vive en el perfil de Graph. Si el
# scope no está consentido, el login sigue funcionando y el menú de sesión muestra el correo.
M365_SCOPES=openid profile email offline_access User.Read

# Origen público del sitio. Es la referencia del chequeo CSRF y se valida contra M365_REDIRECT_URI
# al arrancar (el desajuste entre ambos es el clásico AADSTS50011).
PUBLIC_ORIGIN=http://localhost:5173

# ─── Sesión (cookie httpOnly) ───
SESSION_SECRET=                 # `openssl rand -hex 32`. OBLIGATORIO en producción: sin él, el arranque ABORTA.
SESSION_COOKIE_NAME=puertadeoro.sid   # en producción se le antepone __Host- automáticamente.
SESSION_COOKIE_SECURE=false     # true en producción (HTTPS). En prod se fuerza por NODE_ENV.
SESSION_MAX_AGE_MS=28800000     # 8 h de INACTIVIDAD (se renueva en cada request).
SESSION_VIDA_ABSOLUTA_MS=43200000  # 12 h desde el login, pase lo que pase. Es el tope que
                                   # `rolling` no acota: sin él, una pestaña abierta renueva
                                   # la sesión indefinidamente.
SESSION_PRELOGIN_MS=600000      # 10 min de vida para la sesión que solo lleva PKCE/state/nonce.
# REVALIDATE_INTERVAL_MS=1200000  # cada cuánto revalidar contra Entra (default 20 min).

# ─── Límite de tasa ───
# Cortacircuitos de /auth/login y /auth/redirect por ventana de 15 min y por IP. Es un DIAL:
# con NAT corporativo TODA la sede comparte una IP, así que el día del evento se sube (p. ej. 1000)
# y luego se vuelve a bajar. No es una política de seguridad, es un cortafuegos contra bucles.
AUTH_RATE_LIMIT=300

# ─── Registro de acceso ───
# Ruta del registro de asistencia (JSONL, una línea por evento, con UPN). Si se deja vacío, solo
# se emiten líneas seudónimas (oid) por stdout. Ver docs/SEGURIDAD.md §Registro de acceso para
# permisos, logrotate y plazo de borrado.
AUDIT_LOG_PATH=

# ─── Correo de inscripción ───
# En el PRIMER inicio de sesión de cada persona se envía un correo de confirmación; los inicios
# siguientes no vuelven a escribirle. La memoria de a quién ya se le escribió es el «libro» de
# abajo, indexado por `oid`. Ver server/correo/ y docs/PLAN-CORREO-INSCRIPCION.md.
#
# off       (defecto) la función no existe. Es el valor seguro.
# simulacro recorre todo el flujo y escribe el libro, pero NO llama a Graph. Para ensayar.
# lista     envía SOLO a INSCRIPCION_DESTINATARIOS.
# todos     envía a cualquiera que inicie sesión.
#
# Pasar de `lista` a `todos` exige cambiar DOS variables (el modo y vaciar la lista): ninguna
# errata de una sola puede escribirle al tenant entero.
INSCRIPCION_MODO=off
# CSV separado por COMAS, una dirección por entrada. Obligatorio con modo `lista` y `simulacro`;
# en modo `todos` debe estar VACÍA (con lista puesta, `todos` es un error de configuración: son
# las dos llaves). Una entrada que no sea una dirección aborta el envío en vez de ignorarse.
INSCRIPCION_DESTINATARIOS=
INSCRIPCION_REMITENTE=              # UN buzón del tenant desde el que sale el correo.
# El libro. NO es un log y NUNCA se rota: si se trunca, el servidor vuelve a escribirle a todo el
# mundo. En producción va en /var/lib/gtalks/ (systemd lo crea con StateDirectory), fuera de
# /var/log/gtalks/, que sí rota. En desarrollo, si se deja vacío, cae en .datos/ del repo.
# En modo `simulacro` se le añade el sufijo `.simulacro` SIEMPRE, para que ensayar no deje anotado
# a nadie en el libro real y luego no reciba el correo de verdad.
INSCRIPCION_LIBRO=
# App Registration del envío, con `Mail.Send` de APLICACIÓN y consentimiento de administrador.
# DÉJALAS VACÍAS para reutilizar la app del login (M365_*), que es como está hoy: así el secreto
# vive en UN solo sitio y rotarlo no puede romper el correo en silencio. Llénalas solo si algún
# día el correo pasa a una app propia, y entonces las TRES: a medias mezclaría credenciales y el
# arranque lo rechaza. Ver docs/SEGURIDAD.md §Correo de inscripción.
MAIL_TENANT_ID=
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=

# ─── Envío único del QR de asistencia ───
# NO lo usa el servidor: lo usan `scripts/envio-qr-audiencia.mjs` y `scripts/envio-qr.mjs`, que
# corren en la ESTACIÓN y le mandan a cada invitado —se haya inscrito o no— un correo con su
# código QR personal. Sale UNA vez por persona; la memoria de a quién ya se le escribió es el
# libro de abajo, indexado por `oid`. Ver docs/PLAN-ENVIO-QR.md.
#
# off       (defecto) no hace nada.
# simulacro genera y VERIFICA los 163 QR, escribe el libro `.simulacro` y no llama a Graph.
# lista     envía SOLO a ENVIO_QR_DESTINATARIOS.
# todos     envía a toda la audiencia congelada.
#
# Las mismas dos llaves del correo de inscripción: pasar a `todos` exige cambiar el modo Y vaciar
# la lista. Y además, `--confirmar` obliga a pasar `--maximo N`: si el libro se perdiera, el daño
# son N correos repetidos y no 163.
ENVIO_QR_MODO=off
# CSV por COMAS. En modo `lista` la dirección de destino Y el alias que viaja dentro del QR salen
# de la MISMA cadena de aquí: así la lista blanca no solo controla a quién se escribe, sino qué
# código lleva dentro.
ENVIO_QR_DESTINATARIOS=
ENVIO_QR_REMITENTE=             # el buzón del envío (p. ej. admapps365@gecelca.com.co).
# El libro. Como el de inscripciones: es ESTADO, no un log, y NUNCA se rota. Si se pierde, la
# siguiente corrida le vuelve a escribir a todo el mundo. Por defecto `.datos/envio-qr.jsonl` de
# la estación — RESPÁLDALO al terminar. En ensayo y en simulacro se le añade `.simulacro`.
ENVIO_QR_LIBRO=
# Grupo de seguridad de Entra con los invitados. Leerlo exige `GroupMember.Read.All` de
# APLICACIÓN con consentimiento de administrador; conviene retirarlo cuando termine el envío.
ENVIO_QR_GRUPO=
# Las credenciales de Graph son las mismas del correo de inscripción: MAIL_* si están las tres,
# y si no, M365_*.

# ─── Servidor ───
SERVER_PORT=3000                # puerto del server Express (dev: Vite en 5173 le hace proxy).
SERVER_HOST=127.0.0.1           # SOLO loopback: en producción nginx es el único que le habla.
# Producción: NODE_ENV=production fuerza cookie Secure, activa el prefijo __Host- y hace
# OBLIGATORIAS M365_*, SESSION_SECRET y PUBLIC_ORIGIN (el arranque aborta listando las que falten).
NODE_ENV=
